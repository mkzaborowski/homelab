# --- panel ---
PANEL_HASLO=
SECRET_KEY=

# --- nadawca: Microsoft Graph (zalecane przy Microsoft 365) ---
# Nie wymaga wylaczania domyslnych zabezpieczen dzierzawy i nie podlega
# wygaszaniu podstawowego uwierzytelniania SMTP. Wartosci z rejestracji
# aplikacji w Entra ID (Azure AD) + uprawnienie aplikacyjne Mail.Send.
GRAPH_DZIERZAWA=
GRAPH_KLIENT=
GRAPH_SEKRET=
GRAPH_SKRZYNKA=polisy@ochronazklasa.pl

# --- nadawca zapasowy: SMTP z haslem ---
# Uwaga: Microsoft wyłącza podstawowe uwierzytelnianie SMTP. Do końca grudnia
# 2026 działa bez zmian, potem trzeba je będzie w panelu administracyjnym
# włączyć z powrotem albo przejść na OAuth.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- tempo ---
# Exchange Online przyjmuje 30 listów na minutę i odcina powyżej.
SMTP_NA_MINUTE=20
PRZEBIEG_CO_SEKUND=60
PRZEBIEG_PACZKA=20
