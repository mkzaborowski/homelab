# --- IBKR Flex Web Service ---
# Client Portal -> Reporting -> Flex Queries -> Flex Web Service Configuration
# Token ogranicz do IP serwera: 167.233.204.214 (ważność do 1 roku)
IBKR_TOKEN=
IBKR_QUERY_ID=

# --- panel ---
PANEL_HASLO=
SECRET_KEY=
# pobrania pon-pt; Flex generuje raport raz na dobę, więc dodatkowe przebiegi
# nie dają cen śróddziennych - dają odporność na nieudane pobranie
GODZINY_POBRANIA=08:30,16:00,23:10,02:30

# --- Google Sheets (opcjonalne) ---
# konto serwisowe z Google Cloud; arkusz udostępnij jego adresowi e-mail
GOOGLE_SHEET_ID=
GOOGLE_SA_JSON=/dane/google-sa.json
